# Copy to .env.local (git-ignored) and adjust.
#
# true  -> MSW intercepts every /api/v1/* request in the browser (no backend needed).
# false -> requests go through the Vite proxy to Spring Boot on http://localhost:8080.
VITE_USE_MOCK=true

# Comma-separated mock groups to turn OFF (they hit the real API instead).
# Groups: auth, events, orders, payments, staff, organizer, admin, dev
# Example after backend week 3:  VITE_MOCK_EXCLUDE=auth,events,organizer
VITE_MOCK_EXCLUDE=

# Bank account shown on the VietQR payment screen (https://vietqr.io quick link).
# Demo values only. NEVER transfer real money while in mock mode.
VITE_BANK_ID=MB
VITE_BANK_ACCOUNT_NO=0000123456789
VITE_BANK_ACCOUNT_NAME=CONG TY TICKETBOX DEMO
